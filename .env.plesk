# ─── ClearPhish – Producción Plesk ────────────────────────────────────────────
APP_NAME="ClearPhish"
APP_ENV=production
APP_KEY=                          # Generado con: php artisan key:generate
APP_DEBUG=false
APP_URL=https://phishing.botanalisis.com
APP_TIMEZONE=Europe/Madrid

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_LEVEL=error

# ─── Base de datos MySQL (Plesk) ──────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=clearphish_prod       # Crear en Panel Plesk > Bases de datos
DB_USERNAME=clearphish_user       # Crear en Panel Plesk > Bases de datos
DB_PASSWORD=CAMBIA_ESTO_AHORA

# ─── Sesiones y Caché ─────────────────────────────────────────────────────────
# Usar "database" si no hay Redis disponible en el hosting
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database

# ─── Colas ────────────────────────────────────────────────────────────────────
# Usar "database" si no hay Redis en el hosting
QUEUE_CONNECTION=database

# Si el hosting SÍ tiene Redis (más rápido):
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=redis
# CACHE_STORE=redis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ─── Email (SMTP autorizado de tu org) ────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.gmail.com              # o smtp-relay.gmail.com para Google Workspace
MAIL_PORT=587
MAIL_USERNAME=tu-cuenta@botanalisis.com
MAIL_PASSWORD=tu_app_password
MAIL_FROM_ADDRESS="security@botanalisis.com"
MAIL_FROM_NAME="ClearPhish – BotAnalisis"

# ─── Tracking & Landing ───────────────────────────────────────────────────────
TRACKING_BASE_URL=https://phishing.botanalisis.com
LANDING_BASE_URL=https://phishing.botanalisis.com

# ─── Parámetros de campaña ────────────────────────────────────────────────────
CAMPAIGN_RATE_LIMIT=30
EVENT_RETENTION_DAYS=365
FORM_HASH_VALUES=true
TWO_FA_REQUIRED=false

VITE_APP_NAME="${APP_NAME}"
