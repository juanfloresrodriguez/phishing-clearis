APP_NAME="ClearPhish"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=clearphish
DB_USERNAME=clearphish
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@clearphish.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ─── ClearPhish specific ────────────────────────────────────────────────────
TRACKING_BASE_URL="${APP_URL}"
LANDING_BASE_URL="${APP_URL}"

# Max emails dispatched per minute per campaign (rate limiting)
CAMPAIGN_RATE_LIMIT=60

# Event retention in days (0 = keep forever)
EVENT_RETENTION_DAYS=365

# Hash form field values before storing (true = safer, false = discard entirely)
FORM_HASH_VALUES=true

# 2FA enforcement (optional / required)
TWO_FA_REQUIRED=false

# Google Workspace SMTP Relay (optional – set only when using Google relay)
GOOGLE_SMTP_HOST=smtp-relay.gmail.com
GOOGLE_SMTP_PORT=587
