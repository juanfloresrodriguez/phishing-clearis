APP_NAME="ClearPhish"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Base de datos ────────────────────────────────────────────────────────────
# MySQL (Plesk / producción)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clearphish
DB_USERNAME=clearphish
DB_PASSWORD=secret

# PostgreSQL (Docker / dev avanzado) – descomentar y comentar MySQL si prefieres
# DB_CONNECTION=pgsql
# DB_HOST=postgres
# DB_PORT=5432
# DB_DATABASE=clearphish
# DB_USERNAME=clearphish
# DB_PASSWORD=secret

# ─── Sesiones, caché y colas ─────────────────────────────────────────────────
# "database" funciona en cualquier hosting sin configuración extra
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Si tu hosting tiene Redis, usa estos (más rápido):
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ─── Email ────────────────────────────────────────────────────────────────────
# Dev: usar Mailpit (incluido en Docker Compose)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@clearphish.local"
MAIL_FROM_NAME="${APP_NAME}"

# Producción Google Workspace:
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=tls
# MAIL_USERNAME=tu@tuempresa.com
# MAIL_PASSWORD=app_password_aqui

# Google Workspace SMTP Relay (org con relay configurado):
# MAIL_HOST=smtp-relay.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=tls

VITE_APP_NAME="${APP_NAME}"

# ─── ClearPhish ───────────────────────────────────────────────────────────────
TRACKING_BASE_URL="${APP_URL}"
LANDING_BASE_URL="${APP_URL}"

# Máximo de emails por minuto por campaña
CAMPAIGN_RATE_LIMIT=30

# Retención de eventos en días (0 = indefinido)
EVENT_RETENTION_DAYS=365

# Hash de valores de formulario antes de guardar (true recomendado)
FORM_HASH_VALUES=true

# 2FA obligatorio para admins
TWO_FA_REQUIRED=false
